# Application
APP_NAME=crypto-exchange
APP_ENV=development
DEBUG=true
PYTHONDONTWRITEBYTECODE=1
SECRET_KEY=change-me-generate-a-strong-secret
API_V1_PREFIX=/api/v1

# Database (async URL for SQLAlchemy; sync URL optional for Alembic if split)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/crypto_exchange
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/crypto_exchange

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
